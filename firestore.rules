rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Barbell Diva: ogni utente autenticato accede SOLO al proprio documento
    // barbellDivaAccounts/{uid} e a TUTTE le sue sottoraccolte.
    // La regola wildcard sulle sottoraccolte sostituisce l'elenco manuale, che
    // si dimenticava le raccolte introdotte dopo (es. stateBlobs): con l'elenco
    // manuale le scritture di quelle raccolte venivano negate in silenzio.
    match /barbellDivaAccounts/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
