<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".DivaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.BarbellDiva.EdgeToEdge">

        <!-- MainActivity (sottoclasse di LauncherActivity): apre il sito a tutto
             schermo, senza barra del browser, con login Google funzionante. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:resizeableActivity="true"
            android:theme="@style/Theme.BarbellDiva.EdgeToEdge">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Apre i link del sito DENTRO l'app. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="alicecheon.github.io"
                    android:pathPrefix="/Coaching-App-" />
            </intent-filter>

            <!-- TWA: nessuna barra del browser, con verifica Digital Asset Links. -->
            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="https://alicecheon.github.io/Coaching-App-/" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/colorPrimaryDark" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/colorPrimaryDark" />
            <meta-data
                android:name="android.support.customtabs.trusted.FALLBACK_TYPE"
                android:value="customtabs" />
        </activity>

        <!-- Schermata di emergenza (build diagnostica): mostra l'ultimo errore.
             Gira in un processo separato (:crash) cosi' compare anche se il
             processo principale e' in chiusura. -->
        <activity
            android:name=".CrashActivity"
            android:process=":crash"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Material.NoActionBar" />
    </application>

</manifest>
